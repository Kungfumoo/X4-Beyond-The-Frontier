<?xml version="1.0" encoding="utf-8"?>
<mdscript name="BtfCampaign" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../x4source/md/md.xsd">
    <cues>
        <!-- module is the gamestart id, allows you to limit cues based on gamestart -->
        <cue name="BtfIntro" module="x1g_galaxy_main_0">
            <conditions>
                <event_game_started />
            </conditions>
            <actions>
                <find_sector name="$Sector" macro="macro.x1g_cluster00_sector001_macro" space="player.galaxy"/>
                <find_sector name="$JumpTarget" macro="macro.x1g_cluster50_sector001_macro" space="player.galaxy"/>
                <set_value name="$DroneMacro" exact="macro.ship_gen_s_fightingdrone_01_a_macro"/>

                <!-- Setup Sapporo at start-->
                <create_ship name="$CommandShip" capturable="false" macro="macro.ship_ter_l_flagship_01_a_macro" sector="$Sector" commandeerable="false">
                    <owner exact="faction.terran" overridenpc="true"/>
                    <pilot>
                        <select faction="faction.terran" tags="tag.fighterpilot"/>
                    </pilot>

                    <loadout ref="timelines_sandbox_ter_l" />
                    <paint ware="ware.paintmod_0006"/>
                    <safepos object="player.ship" x="260.3783" y="40.65823" z="600.8676" />
                    <rotation yaw="-179deg" />
                </create_ship>

                <set_object_name object="$CommandShip" name="'Mission Command'" />
                <set_known object="$CommandShip" known="true"/>
                <create_order id="'Wait'" object="$CommandShip" default="true" />

                <run_actions ref="md.LIB_Generic.RequestObjectInvincibility">
                    <param name="Object" value="$CommandShip"/>
                    <param name="RequesterCue" value="namespace"/>
                </run_actions>

                <find_dockingbay name="$CommandShipInternalDock" object="$CommandShip">
                    <match_dock storage="true" size="$DroneMacro.docksize"/>
                </find_dockingbay>

                <!-- TODO: Setup Mission -->
                <create_mission
                    cue="BtfIntro"
                    type="missiontype.plot"
                    name="'X-Prototype Tests'"
                    description="'X prototype test plan'"
                    difficulty="level.easy"
                    faction="faction.terran"
                    abortable="false"
                >
                    <briefing>
                        <objective step="1" action="objective.wait" text="'Await orders'" />
                        <objective step="2" action="objective.custom" customaction="'Increase Throttle'"/>
                        <objective step="3" action="objective.wait" text="'Await orders'" />
                        <objective step="4" action="objective.custom" customaction="'Decrease Throttle'"/>
                        <objective step="5" action="objective.wait" text="'Play around with controls and await orders'" />
                        <objective step="6" action="objective.flyto" text="'Fly to starting ring'" />
                        <objective step="7" action="objective.wait" text="'Await orders'" />
                        <objective step="8" action="objective.flyto" text="'Fly through rings'" />
                        <objective step="9" action="objective.wait" text="'Await orders'" />
                        <objective step="10" action="objective.find" text="'Target deployed drones'" />
                        <objective step="11" action="objective.wait" text="'Await orders'" />
                    <!--
                        <objective step="3" action="objective.deploy"       text="{30179,6022}"          comment="deploy probe"/>
                        <objective step="4" action="objective.investigate"  text="{30179,6022}"          comment="select probe"/>
                        <objective step="5" action="objective.investigate"  text="{30179,6023}"          comment="investigate asteroids"/>
                        <objective step="6" action="objective.activate"     text="{30179,6024}"          comment="Activate mining equipment"/>
                        <objective step="7" action="objective.wait"         text="{30179,6025}"          comment="Observe mining operation"/>
                    -->
                    </briefing>
                </create_mission>

                <!-- TODO: flight school tutorial -->

                <!-- TODO: Skip (shift-x) to start game to seizewell -->
            </actions>
            <delay exact="5s" />
            <actions>
                <!-- Start intro-->
                <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="1" priority="90" />
                <set_objective_from_briefing cue="BtfIntro" step="1"/>
                <signal_cue cue="BtfIntro_AccelerateTest" />
            </actions>
            <cues>
                <cue name="BtfIntro_CommandShip_Conversation" instantiate="true">
                    <conditions>
                        <event_conversation_started actor="$CommandShip.pilot"/>
                    </conditions>
                    <actions>
                        <add_player_choice highlighted="true" text="'Skip Tutorial'" section="skipper_xbtf_tutorial" position="top_left" />
                    </actions>
                    <cues>
                        <cue name="BtfIntro_CommandShip_Conversation_Skip">
                            <conditions>
                                <event_conversation_next_section actor="$CommandShip.pilot" section="skipper_xbtf_tutorial" />
                            </conditions>
                            <actions>
                                <signal_cue cue="BtfIntro_Jump" />
                            </actions>
                        </cue>
                    </cues>
                </cue>
                <cue name="BtfIntro_Jump">
                    <conditions>
                        <event_cue_signalled />
                    </conditions>
                    <actions>
                        <show_help custom="'JUMP SEQUENCE'"/>
                        <!--
                        TODO: Jump sequence:
                            - jump sequence/cutscene
                            - hide earth sector
                            - reset ship configuration
                            - boom boom cutscene
                            - complete mission rather then hide it?
                        -->
                        <warp object="player.ship" sector="$JumpTarget">
                            <safepos value="position.[0,0,10km]" radius="2km"/>
                        </warp>
                        <remove_mission cue="BtfIntro" />
                        <cancel_cue cue="BtfIntro" />
                    </actions>
                </cue>
                <cue name="BtfIntro_AccelerateTest">
                    <conditions>
                        <event_cue_signalled />
                    </conditions>
                    <delay exact="19s" />
                    <actions>
                        <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="2" priority="90" />
                        <show_help_multi log="true" position="1" force="true" allowclose="false" width="180">
                            <text line="26416" comment="Use the mouse wheel or press $INPUT_STATE_ACCELERATE$ to accelerate."/>
                            <!-- <text line="" comment="Shift-X to skip tutorial."/> -->
                        </show_help_multi>
                    </actions>
                    <delay exact="28s" />
                    <actions>
                        <remove_help all="true" />
                        <set_objective_from_briefing cue="BtfIntro" step="2"/>
                        <signal_cue cue="BtfIntro_AccelerateTest_Player_Accelerate" />
                    </actions>
                    <cues>
                        <cue name="BtfIntro_AccelerateTest_Player_Accelerate">
                            <conditions>
                                <event_cue_signalled />
                            </conditions>
                            <cues>
                                <cue name="BtfIntro_AccelerateTest_Player_Accelerate_Check" checkinterval="0.5s">
                                    <conditions>
                                        <check_value value="player.input.flight.throttle == 1"/>
                                    </conditions>
                                    <actions>
                                        <signal_cue cue="BtfIntro_DecelerateTest" />
                                    </actions>
                                </cue>
                            </cues>
                        </cue>
                    </cues>
                </cue>
                <cue name="BtfIntro_DecelerateTest">
                    <conditions>
                        <event_cue_signalled />
                        <cue_is_complete cue="BtfIntro_AccelerateTest" />
                    </conditions>
                    <delay exact="3s" />
                    <actions>
                        <set_objective_from_briefing cue="BtfIntro" step="3"/>
                        <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="3" priority="90" />
                        <set_playership_throttle value="0" />
                        <show_help_multi log="true" position="1" force="true" allowclose="false" width="180">
                            <text line="26418" comment="Use the mouse wheel or press $INPUT_STATE_DECELERATE$ to decelerate."/>
                            <!-- <text line="" comment="Shift-X to skip tutorial."/> -->
                        </show_help_multi>
                    </actions>
                    <delay exact="17s" />
                    <actions>
                        <remove_help all="true" />
                        <set_objective_from_briefing cue="BtfIntro" step="4"/>
                        <signal_cue cue="BtfIntro_DecelerateTest_Player_Decelerate" />
                    </actions>
                    <cues>
                        <cue name="BtfIntro_DecelerateTest_Player_Decelerate">
                            <conditions>
                                <event_cue_signalled />
                            </conditions>
                            <cues>
                                <cue name="BtfIntro_DecelerateTest_Player_Decelerate_Check" checkinterval="0.5s">
                                    <conditions>
                                        <check_value value="player.input.flight.throttle lt 0"/>
                                    </conditions>
                                    <actions>
                                        <signal_cue cue="BtfIntro_MovementFreeTest" />
                                    </actions>
                                </cue>
                            </cues>
                        </cue>
                    </cues>
                </cue>
                <cue name="BtfIntro_MovementFreeTest">
                    <conditions>
                        <event_cue_signalled />
                        <cue_is_complete cue="BtfIntro_DecelerateTest" />
                    </conditions>
                    <delay exact="3s" />
                    <actions>
                        <set_playership_throttle value="0" />
                        <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="4" priority="90" />
                    </actions>
                    <delay exact="16s" />
                    <actions>
                        <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="5" priority="90" />
                        <set_objective_from_briefing cue="BtfIntro" step="5"/>
                        <show_help_multi log="true" position="1" force="true" allowclose="false" width="180">
                            <text line="26404" comment="$INPUT_STATE_TOGGLEMOUSESTEERING$\' to enable MOUSE STEERING until you release it."/>
                            <text line="26413" comment="Use $INPUT_STATE_STRAFE_LEFT$, $INPUT_STATE_STRAFE_RIGHT$, $INPUT_STATE_STRAFE_UP$ and $INPUT_STATE_STRAFE_DOWN$ to strafe."/>
                            <text line="26411" comment="Use $INPUT_STATE_ROLL_LEFT$ and $INPUT_STATE_ROLL_RIGHT$ to roll your ship."/>
                            <text line="26419" comment="Press $INPUT_ACTION_STOP$ to come to a full stop."/>
                            <!-- <text line="" comment="Shift-X to skip tutorial."/> -->
                        </show_help_multi>
                    </actions>
                    <delay exact="26s" />
                    <actions>
                        <play_sound sound="'intro_chatter'" type="ui" />
                    </actions>
                    <delay exact="60s" />
                    <actions>
                        <signal_cue cue="BtfIntro_RingTest" />
                    </actions>
                </cue>
                <cue name="BtfIntro_RingTest">
                    <conditions>
                        <event_cue_signalled />
                        <cue_is_complete cue="BtfIntro_MovementFreeTest" />
                    </conditions>
                    <actions>
                        <set_value name="$Rings" exact="[]" />
                    </actions>
                    <delay exact="3s" />
                    <actions>
                        <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="6" priority="90" />
                    </actions>
                    <delay exact="19s" />
                    <actions>
                        <set_objective cue="BtfIntro" step="6" action="objective.flyto" object="$Rings.{1}" />
                        <signal_cue cue="BtfIntro_RingTest_Intro" />
                    </actions>
                    <cues>
                        <cue name="BtfIntro_RingTest_Spawn">
                            <actions>
                                <!-- TODO: expand with more rings -->
                                <set_value name="$ringLocations" exact="[
                                    table[$x = 0, $y = 40.65, $z = 3000.86, $yaw = 0deg, $pitch = 180deg, $roll = 0deg],
                                    table[$x = -300, $y = 40.65, $z = 4000.86, $yaw = -30deg, $pitch = 180deg, $roll = 0deg],
                                    table[$x = -1200, $y = 40.65, $z = 5000.86, $yaw = -60deg, $pitch = 180deg, $roll = 0deg],
                                    table[$x = -2100, $y = 40.65, $z = 5300.86, $yaw = -90deg, $pitch = 180deg, $roll = 0deg],
                                    table[$x = -3100, $y = 340.65, $z = 5300.86, $yaw = -90deg, $pitch = 150deg, $roll = 0deg],
                                    table[$x = -4100, $y = 1240.65, $z = 5300.86, $yaw = -90deg, $pitch = 120deg, $roll = 0deg],
                                    table[$x = -4400, $y = 2140.65, $z = 5300.86, $yaw = -90deg, $pitch = 90deg, $roll = 0deg]
                                ]" />

                                <do_for_each name="$ringPos" in="$ringLocations">
                                    <create_object name="$Ring" macro="macro.triggerobject_race_checkpoint_01_macro" owner="faction.ownerless" sector="$Sector" spinning="0">
                                        <safepos object="$CommandShip" x="$ringPos.{'$x'}" y="$ringPos.{'$y'}" z="$ringPos.{'$z'}" />
                                        <rotation yaw="$ringPos.{'$yaw'}" pitch="$ringPos.{'$pitch'}" roll="$ringPos.{'$roll'}"/>
                                    </create_object>
                                    <run_actions ref="md.LIB_Generic.RequestObjectInvincibility">
                                        <param name="Object" value="$Ring"/>
                                        <param name="RequesterCue" value="namespace"/>
                                    </run_actions>
                                    <append_to_list name="$Rings" exact="$Ring"/>
                                </do_for_each>
                            </actions>
                        </cue>
                        <cue name="BtfIntro_RingTest_Intro">
                            <conditions>
                                <event_cue_signalled />
                            </conditions>
                            <cues>
                                <cue name="BtfIntro_RingTest_Intro_PositionCheck" checkinterval="0.5s">
                                    <conditions>
                                        <check_value value="player.ship.distanceto.{$Rings.{1}} le 1km" />
                                    </conditions>
                                    <actions>
                                        <set_objective_from_briefing cue="BtfIntro" step="7" />
                                        <set_playership_throttle value="0" />
                                        <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="7" priority="90" />
                                    </actions>
                                    <delay exact="60s"/>
                                    <actions>
                                        <signal_cue cue="BtfIntro_RingTest_Run" />
                                    </actions>
                                </cue>
                            </cues>
                        </cue>
                        <cue name="BtfIntro_RingTest_Run">
                            <conditions>
                                <event_cue_signalled />
                            </conditions>
                            <actions>
                                <set_value name="$ringCounter" exact="1" />
                            </actions>
                            <cues>
                                <cue name="BtfIntro_RingTest_Run_RingObjective"> <!-- Recursive-->
                                    <actions>
                                        <set_objective cue="BtfIntro" step="8" action="objective.flyto" object="$Rings.{$ringCounter}" />
                                    </actions>
                                    <cues>
                                        <cue name="BtfIntro_RingTest_Run_RingObjective_PositionCheck" checkinterval="0.5s">
                                            <conditions>
                                                <check_value value="player.ship.distanceto.{$Rings.{$ringCounter}} le 100m" />
                                            </conditions>
                                            <actions>
                                                <set_value name="$ringCounter" exact="$ringCounter + 1" />
                                                <do_if value="$ringCounter gt $Rings.count">
                                                    <signal_cue cue="BtfIntro_RingTest_Run_Finish" />
                                                </do_if>
                                                <do_else>
                                                    <reset_cue cue="BtfIntro_RingTest_Run_RingObjective" />
                                                </do_else>
                                            </actions>
                                        </cue>
                                    </cues>
                                </cue>
                                <cue name="BtfIntro_RingTest_Run_Finish">
                                    <conditions>
                                        <event_cue_signalled />
                                    </conditions>
                                    <actions>
                                        <set_objective_from_briefing cue="BtfIntro" step="9" />
                                        <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="8" priority="90" />
                                    </actions>
                                    <delay exact="7s" />
                                    <actions>
                                        <do_for_each name="$Ring" in="$Rings">
                                            <destroy_object object="$Ring" />
                                        </do_for_each>
                                        <signal_cue cue="BtfIntro_TargetDroneTest" />
                                    </actions>
                                </cue>
                            </cues>
                        </cue>
                    </cues>
                </cue>
                <cue name="BtfIntro_TargetDroneTest">
                    <conditions>
                        <event_cue_signalled />
                        <cue_is_complete cue="BtfIntro_RingTest" />
                    </conditions>
                    <actions>
                        <set_value name="$Drones" exact="[]" /> <!-- Used to keep tabs on created drones to despawn -->
                        <create_group groupname="$DroneGroup" /> <!-- Used for the mission logic -->
                    </actions>
                    <delay exact="3s" />
                    <actions>
                        <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="9" priority="90" />
                        <show_help_multi log="true" position="1" force="true" allowclose="false" width="180">
                            <text line="27001" comment="Point towards the nearby ship then press $INPUT_ACTION_TARGET_NEXT_TARGET$ to make it your target." />
                            <text line="27002" comment="Click on the nearby ship to make it your target." />
                            <!-- <text line="27003" comment="Press $INPUT_ACTION_TARGET_NEXT_ENEMY$ to target the closest hostile." /> -->
                            <text line="27004" comment="Press $INPUT_ACTION_NEXT_TARGET_ACTION$ and $INPUT_ACTION_PREV_TARGET_ACTION$ to cycle through targets." />
                            <!-- <text line="27005" comment="Press $INPUT_ACTION_TARGET_NEXT_ENEMY$ to target the closest hostile. This also locks the target." /> -->
                            <text line="27006" comment="Press $INPUT_ACTION_NEXT_TARGET_ACTION$ to cycle through targets." />
                        </show_help_multi>
                    </actions>
                    <delay exact="38s"/>
                    <actions>
                        <signal_cue cue="BtfIntro_TargetDroneTest_TargetObjective" />
                    </actions>
                    <cues>
                        <cue name="BtfIntro_TargetDroneTest_SpawnDrones">
                            <actions>
                                <!-- Spawn 2 drones and undock from ship -->
                                <do_all exact="2">
                                    <create_ship name="$Drone" macro="$DroneMacro" dock="$CommandShipInternalDock" capturable="false">
                                        <owner exact="$CommandShip.owner" overridenpc="true" />
                                        <pilot>
                                            <select race="race.drone" tags="tag.aipilot"/>
                                        </pilot>
                                    </create_ship>
                                    <set_object_commander object="$Drone" commander="$CommandShip" />
                                    <create_order id="'Follow'" object="$Drone">
                                        <param name="target" value="$CommandShip" />
                                    </create_order>

                                    <add_to_group groupname="$DroneGroup" object="$Drone" />
                                    <append_to_list name="$Drones" exact="$Drone" />
                                </do_all>
                            </actions>
                        </cue>
                        <cue name="BtfIntro_TargetDroneTest_TargetObjective">
                            <conditions>
                                <event_cue_signalled />
                            </conditions>
                            <actions>
                                <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="10" priority="90" />
                                <set_objective action="objective.find" cue="BtfIntro" group="$DroneGroup" text="'Target Drone'" />
                            </actions>
                            <cues>
                                <cue name="BtfIntro_TargetDroneTest_TargetObjective_ChangeCheck" instantiate="true">
                                    <conditions>
                                        <event_player_changed_target />
                                    </conditions>
                                    <actions>
                                        <set_value name="$NewTarget" exact="event.param" />
                                        <do_if value="$DroneGroup.indexof.{$NewTarget} != 0">
                                            <remove_from_group group="$DroneGroup" object="$NewTarget" />

                                            <do_if value="$DroneGroup.count == 0">
                                                <signal_cue cue="BtfIntro_TargetDroneTest_Final" />
                                                <cancel_cue cue="static" /> <!-- cancelling static prevents additional instantiations -->
                                            </do_if>
                                            <do_else>
                                                <set_objective action="objective.find" cue="BtfIntro" group="$DroneGroup" text="'Target Drone'" />
                                            </do_else>
                                        </do_if>
                                    </actions>
                                </cue>
                            </cues>
                        </cue>
                        <cue name="BtfIntro_TargetDroneTest_Final">
                            <conditions>
                                <event_cue_signalled />
                            </conditions>
                            <actions>
                                <set_objective_from_briefing cue="BtfIntro" step="11" />
                                <speak actor="$CommandShip.pilot" recipient="player.entity" page="19530001" line="11" priority="90" />
                            </actions>
                            <delay exact="23s" />
                            <actions>
                                <do_for_each name="$Drone" in="$Drones">
                                    <destroy_object object="$Drone" />
                                </do_for_each>
                                <signal_cue cue="BtfIntro_CombatTest" />
                            </actions>
                        </cue>
                    </cues>
                </cue>
                <cue name="BtfIntro_CombatTest">
                    <conditions>
                        <event_cue_signalled />
                        <cue_is_complete cue="BtfIntro_TargetDroneTest" />
                    </conditions>
                    <delay exact="3s" />
                    <actions>
                        <show_help custom="'COMBAT TEST'" />
                    </actions>
                </cue>
            </cues>
        </cue>
    </cues>
</mdscript>